{
  "name": "joy-mollik-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["apps/web", "apps/api"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm run dev -w @joy/api\" \"npm run dev -w @joy/web\"",
    "dev:web": "npm run dev -w @joy/web",
    "dev:api": "npm run dev -w @joy/api",
    "build": "npm run build -w @joy/web",
    "start": "npm run start -w @joy/api",
    "test": "npm run test -w @joy/api"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
